    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@alive/markdown": "file:../packages/markdown",
    "@alive/theme": "file:../packages/theme",
    "markdown-it": "14.1.0",
    "nuxt": "3.21.11",
    "pinia": "3.0.4",
    "vue": "3.5.41",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.15.2",
    "@pinia/nuxt": "0.11.2",
    "@types/markdown-it": "14.1.2",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "^4.1.0",
    "vue-tsc": "2.2.12"
  },
  "overrides": {
    "eslint-flat-config-utils": "3.0.2",
    "eslint-plugin-regexp": "3.1.1"
