# Backend origin. No trailing slash and no /api/v1 suffix — the API client adds
# the version prefix itself.
#
# Copy this file to .env for local development. .env is not committed.
NUXT_PUBLIC_API_BASE=http://localhost:8080

# SSR-only API origin. Leave empty for the normal local process workflow.
# Docker Compose sets this to the backend service name so it is never exposed
# to browser JavaScript.
# NUXT_API_INTERNAL_BASE=http://backend:8080
