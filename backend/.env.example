# Copy to .env and adjust. .env is git-ignored and must never be committed.
#
# The process reads the environment, not this file. Load it with `set -a;
# source .env; set +a`, or with `direnv`, or through your run configuration.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# development | production
# development uses text logs at debug level; production uses JSON at info.
APP_ENV=development

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
# 127.0.0.1 keeps the server off the network while developing.
# Set 0.0.0.0 only when something outside the machine must reach it.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
# How long in-flight requests may finish after a shutdown signal.
SERVER_SHUTDOWN_TIMEOUT=10s

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Either set DATABASE_URL directly:
DATABASE_URL=postgres://alive:alive@127.0.0.1:5432/alive?sslmode=disable
#
# ...or leave it empty and set the parts below instead. DATABASE_URL wins when
# both are present.
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=alive
# DB_PASSWORD=alive
# DB_NAME=alive
# DB_SSLMODE=disable

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
# Bounds the connectivity check at startup.
DB_CONNECT_TIMEOUT=5s

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated exact origins, scheme included. "*" is rejected: this API
# allows credentials, and browsers refuse to send them to a wildcard origin.
#
# Development needs these two: the Nuxt (3000) and Vite (5173) dev servers are
# separate origins from the API on 8080.
#
# Production must set this to empty. admin is served from /admin on the site's
# own domain, so browser calls to /api are same-origin and no CORS exchange
# happens. An empty value here means exactly that; it is not the same as leaving
# the variable out, which restores the development default.
#
#   CORS_ALLOWED_ORIGINS=
#
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_MAX_AGE=12h

# ---- Session ----------------------------------------------------------------
#
# How long a session lives from its last renewal. Also the cookie's Max-Age, so
# the browser stops sending the token at about the moment the server stops
# accepting it. A session past halfway through this window is extended on use.
SESSION_LIFETIME=168h

# The cookie's name and path. Path decides where the credential is sent at all,
# and narrower is better: /api/v1 covers the API and keeps the cookie off
# requests for pages and assets.
#
# Unlike CORS_ALLOWED_ORIGINS, an empty value here is not a setting. These two
# are read so that absent means "use the default" and empty is an error, because
# a config file that says nothing and a server that picked a name silently is a
# discrepancy nobody finds until a cookie goes missing.
SESSION_COOKIE_NAME=alive_session
SESSION_COOKIE_PATH=/api/v1

# Restrict the session cookie to HTTPS.
#
# Set to false for local development only: http://localhost never receives a
# Secure cookie, so login appears broken with nothing in the response to say
# why. With APP_ENV=production, false makes the server refuse to start, because
# the alternative is a session token travelling in the clear and looking fine.
SESSION_COOKIE_SECURE=false

# ---- Rate limit -------------------------------------------------------------
#
# Applies to POST /api/v1/auth/login only. Every other route is either cheap or
# already behind a session, and limiting those would cost normal use to slow
# down an attacker who is not attacking there.
#
# The counter is a fixed window held in this process's memory. Two consequences,
# both accepted: the counts reset when the process restarts, and they are not
# shared if the service is ever run as more than one instance.
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW=1m

# Turning the limiter off is for local scripts that log in repeatedly. With
# APP_ENV=production, false makes the server refuse to start: an unlimited login
# endpoint can be brute-forced, and each attempt costs one ~200 ms password
# hash, so it is also a way to spend the server's CPU.
RATE_LIMIT_ENABLED=true
