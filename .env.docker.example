# Copy this file to .env before the first `docker compose` command.
# Use only URL-safe characters (letters, numbers, hyphen, underscore) because
# the migration container embeds this value in a PostgreSQL URL.
ALIVE_DB_PASSWORD=replace-with-a-long-random-value

# The local appliance is intentionally bound to this computer only.
ALIVE_BIND_ADDRESS=127.0.0.1
ALIVE_PORT=8081

# Optional Aliyun OSS media uploads. Leave disabled for a local-only install.
OSS_ENABLED=false
# OSS_REGION=cn-hangzhou
# OSS_ENDPOINT=
# OSS_BUCKET=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_PUBLIC_BASE_URL=https://media.example.com
