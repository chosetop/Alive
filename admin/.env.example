# Base URL of the Alive backend, scheme and port included, no trailing slash.
# The path prefix (/api/v1) is added by the API client, not here.
#
# The backend's CORS_ALLOWED_ORIGINS must list this dev server's origin
# (http://localhost:5173 by default). A credentialed API cannot use "*".
#
# Local development also needs SESSION_COOKIE_SECURE=false on the backend:
# http://localhost never receives a Secure cookie, so login would appear to
# succeed while no session cookie is ever stored.
VITE_API_BASE_URL=http://localhost:8080
